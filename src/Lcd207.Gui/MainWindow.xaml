<Window x:Class="Lcd207.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LANCOOL 207 LCD" Icon="app.ico" Width="860" Height="560" MinWidth="500" MinHeight="340"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="#EEE">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rotation" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="RotationBox" Grid.Column="1" SelectedIndex="0" SelectionChanged="Options_Changed">
                <ComboBoxItem Content="Auto" Tag="" />
                <ComboBoxItem Content="0°" Tag="0" />
                <ComboBoxItem Content="90°" Tag="90" />
                <ComboBoxItem Content="180°" Tag="180" />
                <ComboBoxItem Content="270°" Tag="270" />
            </ComboBox>
            <TextBlock Grid.Column="3" Text="Fit" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="FitBox" Grid.Column="4" SelectedIndex="0" SelectionChanged="Options_Changed">
                <ComboBoxItem Content="Cover" Tag="Cover" />
                <ComboBoxItem Content="Contain" Tag="Contain" />
                <ComboBoxItem Content="Stretch" Tag="Stretch" />
            </ComboBox>
        </Grid>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="Drop an image on the panel area, or click it to browse." />

        <Border x:Name="DropZone" AllowDrop="True" Cursor="Hand" CornerRadius="6"
                BorderBrush="#555" BorderThickness="2" Background="#111"
                DragEnter="DropZone_DragEnter" DragOver="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop" MouseLeftButtonUp="DropZone_Click">
            <Viewbox Stretch="Uniform" Margin="8">
                <Grid>
                    <!-- Panel framebuffer is 720x1472 portrait; it's mounted landscape in the case,
                         so show it rotated 90° CCW (auto-rotate sends landscape images 90° CW). -->
                    <Grid Width="720" Height="1472" Background="Black">
                        <Grid.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </Grid.LayoutTransform>
                        <Image x:Name="Preview" Stretch="Fill" />
                    </Grid>
                    <TextBlock x:Name="DropHint" Text="Drop image here" FontSize="64" Foreground="#666"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Viewbox>
        </Border>
    </DockPanel>
</Window>
